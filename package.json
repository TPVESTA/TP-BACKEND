{
  "name": "vesta-api",
  "version": "1.0.0",
  "description": "Vesta: API de administración de consorcios",
  "main": "dist/app.js",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "dev:watch": "nodemon --exec ts-node src/app.ts",
    "seed": "ts-node src/database/seed.ts",
    "test": "node --test tests/*.test.cjs",
    "test:reservas": "node --test tests/business-permissions.test.cjs tests/reservacion-availability.test.cjs",
    "test:reservas:mysql": "node --test tests/reservacion-mysql.test.cjs"
  },
  "keywords": [
    "express",
    "nodejs",
    "api",
    "consorcios",
    "utn",
    "vesta"
  ],
  "author": "UTN - Desarrollo de Software",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@mikro-orm/core": "^6.4.16",
    "@mikro-orm/mysql": "^6.4.16",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "joi": "^18.0.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.7",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
